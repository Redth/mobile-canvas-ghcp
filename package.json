{
  "name": "mobile-canvas",
  "version": "0.1.18",
  "description": "Run and control local iOS Simulators and Android emulators in a live Copilot canvas, with agent-ready device automation.",
  "main": "extension.mjs",
  "type": "module",
  "license": "MIT",
  "author": "Jonathan Dick",
  "keywords": [
    "ios",
    "android",
    "simulator",
    "emulator",
    "copilot-canvas",
    "canvas",
    "mobile",
    "device-control",
    "mobile-testing",
    "device-automation"
  ],
  "scripts": {
    "ailoha:manifest": "node scripts/ailoha-source-manifest.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "package:plugin": "node scripts/prepare-plugin.mjs",
    "package:plugin:thin": "node scripts/prepare-plugin.mjs --thin",
    "package:runtimes": "node scripts/package-runtime-assets.mjs",
    "publish:vscode": "node scripts/publish-vscode.mjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "latest"
  },
  "files": [
    "extension.mjs",
    "extensions/",
    "lib/",
    "runtimes/",
    "scripts/",
    "web/",
    "assets/",
    "docs/",
    "README.md",
    "LICENSE"
  ]
}
